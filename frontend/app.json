{
  "expo": {
    "name": "JARVIS",
    "slug": "jarvis-mobile-frontend",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "jarvis",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "자비스에게 음성으로 요청하려면 마이크 접근이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070A12"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
