APP_NAME=JARVIS Backend
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_password@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0
# Postgres에서는 false로 두고 `alembic upgrade head`로 스키마를 만든다.
AUTO_CREATE_TABLES=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

# 인증. true로 켜면 /api/v1 라우트가 Bearer 토큰을 요구한다.
AUTH_REQUIRED=false
OAUTH_ISSUER_URL=
OAUTH_AUDIENCE=
# 비우면 OAUTH_ISSUER_URL + /.well-known/jwks.json 을 사용한다.
OAUTH_JWKS_URL=
# AUTH_REQUIRED=false일 때 쓰는 로컬 사용자 ID
DEV_USER_ID=local-user

# 대화 컨텍스트
CHAT_HISTORY_LIMIT=12
CHAT_MEMORY_LIMIT=5

LOG_LEVEL=INFO
